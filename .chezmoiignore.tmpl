# Repo-only files. These are kept in the chezmoi source repo but are not
# materialized under $HOME.
.gitignore
README.md
bootstrap.sh
docs/**

# Desktop GUI configuration (Niri, Alacritty, Kitty, Matugen)
# Materialized on "eagle" (desktop workstation); ignored on server hosts.
{{ if ne .chezmoi.hostname "eagle" -}}
.config/niri/**
.config/alacritty/**
.config/kitty/**
.config/matugen/**
{{ end -}}

# tmux -> psmux CLI compatibility shim. Only needed on Windows, where psmux
# stands in for tmux; on real tmux hosts it would just be a harmless but
# confusing passthrough wrapper.
{{ if ne .chezmoi.os "windows" -}}
.local/bin/tmux
{{ end -}}
