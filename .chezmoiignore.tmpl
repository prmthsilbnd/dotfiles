# Repo-only files. These are kept in the chezmoi source repo but are not
# materialized under $HOME.
.gitignore
README.md
bootstrap.sh
docs/**

# Desktop GUI configuration (Niri, Alacritty, Kitty, Matugen)
# Materialized on "eagle" (desktop workstation); ignored on server hosts.
{{ if ne .chezmoi.hostname "eagle" -}}
.config/niri/**
.config/alacritty/**
.config/kitty/**
.config/matugen/**
{{ end -}}

# tmux status scripts: bash ones for real tmux, a PowerShell one for psmux on
# Windows. TPM setup is skipped on Windows too; see docs/tmux.md.
{{ if eq .chezmoi.os "windows" -}}
.config/tmux/scripts/status-metric
.config/tmux/scripts/status-battery
.config/tmux/scripts/status-identity
10-tmux-setup.sh
{{ else -}}
.config/tmux/scripts/status-windows.ps1
{{ end -}}
