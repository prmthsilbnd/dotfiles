# Default-deny dotfiles repo. Unignore only explicit tracked paths.
*

!.gitignore
!.chezmoiignore
!.chezmoiignore.tmpl
!dot_XCompose
!dot_zshrc
!dot_tmux.conf
!README.md
!bootstrap.sh
!run_onchange_after_10-tmux-setup.sh

!docs/
!docs/*.md

!private_dot_local/
!private_dot_local/bin/
!private_dot_local/bin/executable_dotfiles-fastfetch
!private_dot_local/bin/executable_tmux

!private_dot_config/
